# ==========================================
# LogoGenius - Environment Configuration
# ==========================================

# ==========================================
# REQUIRED: Core Application
# ==========================================

# Database - MySQL connection string
# Format: mysql://username:password@host:port/database?sslmode=require
# Get from: Railway, PlanetScale, AWS RDS, or your VPS
DATABASE_URL=mysql://username:password@host:port/database?sslmode=require

# Admin Authentication
# Set a strong password for admin panel access
ADMIN_PASSWORD=your-secure-admin-password-here

# JWT Secret - for signing authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here

# ==========================================
# REQUIRED: AI Services (Pick at least one)
# ==========================================

# Google API Key - REQUIRED for form auto-fill (FREE tier available)
# Get from: https://ai.google.dev
# Used for: Form auto-fill, brand guide text generation
GOOGLE_API_KEY=your_google_ai_key_here

# --- Provider 1: Together AI (Default for testing) ---
# Cost: ~$0.001/image | Free $5 credit on signup
# Signup: https://api.together.xyz
# Used for: Logo generation
TOGETHER_API_KEY=your_together_api_key_here

# --- Provider 2: Replicate (Recommended for production) ---
# Cost: ~$0.05/image | Free $5 credit on signup
# Signup: https://replicate.com
# Used for: Logo generation (Google Imagen 3)
REPLICATE_API_KEY=your_replicate_api_key_here

# --- Provider 3: Fal.ai ---
# Cost: ~$0.15/image
# Signup: https://fal.ai
# Used for: Logo generation
FAL_API_KEY=your_fal_api_key_here

# --- Provider 4: Laozhang.ai ---
# Cost: ~$0.05/image
# Signup: https://laozhang.ai
# Used for: Logo generation
LAOZHANG_API_KEY=your_laozhang_api_key_here

# ==========================================
# OPTIONAL: Image Generation Provider Selection
# ==========================================

# Set this to switch between providers
# Options: together | replicate | fal | google | laozhang
# Default: together
IMAGE_GEN_PROVIDER=together

# ==========================================
# OPTIONAL: Application URLs
# ==========================================

# Base URL of your application
# Used for: Email links, metadata, redirects
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Site URL for email templates
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ==========================================
# OPTIONAL: Third-Party Integrations
# ==========================================

# Figma API - for generating Figma templates (Tier 3)
# Get from: https://www.figma.com/developers/api
FIGMA_API_TOKEN=your_figma_token_here

# Canva API - for generating Canva templates (Tier 3)
# Get from: https://www.canva.com/developers/
CANVA_API_KEY=your_canva_key_here
CANVA_TEAM_ID=your_canva_team_id_here

# ==========================================
# OPTIONAL: Testing & Development
# ==========================================

# Test mode - uses cheaper/faster options
# Options: testing | production
# Default: testing
MODE=testing

# Track AI generation costs
# Default: false
TRACK_GENERATION_COSTS=false

# ==========================================
# DEPRECATED: Old Variable Names (don't use)
# ==========================================
# ADMIN_KEY (use ADMIN_PASSWORD instead)
# GENKIT_API_KEY (use GOOGLE_API_KEY instead)
# TEST_GOOGLE_API_KEY (use GOOGLE_API_KEY instead)
