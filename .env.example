# ==========================================
# LogoGenius - Environment Configuration
# ==========================================

# Database
DATABASE_URL=mysql://username:password@host:port/database?sslmode=require

# Admin Authentication
ADMIN_KEY=your-secure-admin-key-here

# ==========================================
# Image Generation Provider Selection
# ==========================================
# Set this to switch between providers - NO CODE CHANGES NEEDED!
# Options: together | replicate | fal | google

IMAGE_GEN_PROVIDER=together

# --- Provider 1: Together AI (Default) ---
# Cheapest: ~$0.001/image
# Quality: Good for concepts, requires optimization
# Signup: https://api.together.xyz
TOGETHER_API_KEY=your_together_api_key_here

# --- Provider 2: Replicate ---
# Cost: ~$0.05/image for Imagen 3
# Quality: Excellent (hosts Google Imagen)
# Signup: https://replicate.com
REPLICATE_API_KEY=your_replicate_api_key_here

# --- Provider 3: Fal.ai ---
# Cost: ~$0.15/image for Imagen 3
# Quality: Excellent, fastest
# Signup: https://fal.ai
FAL_API_KEY=your_fal_api_key_here

# --- Provider 4: Google Imagen (Direct) ---
# Cost: ~$0.04/image
# Quality: Best for logos
# Setup: Enable Vertex AI or Generative Language API
GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# Optional: Advanced Settings
# ==========================================

# Default image generation model (provider-specific)
# TOGETHER_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# REPLICATE_MODEL=google/imagen-3

# Cost tracking
TRACK_GENERATION_COSTS=true
