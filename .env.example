# LogoGenius Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED: Database
# ============================================
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/logogenius

# ============================================
# REQUIRED: Authentication
# ============================================
# Admin dashboard password
ADMIN_PASSWORD=your-secure-admin-password

# JWT secret for session tokens (generate a random string)
JWT_SECRET=your-random-secret-key-min-32-characters

# ============================================
# REQUIRED: Application
# ============================================
# Base URL for the application
NEXT_PUBLIC_BASE_URL=http://localhost:9002

# ============================================
# OPTIONAL: Email Service
# ============================================
# Choose one email provider:

# SendGrid
# SENDGRID_API_KEY=SG.xxx
# EMAIL_FROM=noreply@logogenius.com

# Mailgun
# MAILGUN_API_KEY=key-xxx
# MAILGUN_DOMAIN=mg.logogenius.com
# EMAIL_FROM=noreply@logogenius.com

# AWS SES
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1
# EMAIL_FROM=noreply@logogenius.com

# ============================================
# OPTIONAL: Third-Party Templates (Tier 3)
# ============================================
# Figma API for template generation
# FIGMA_API_TOKEN=figd_xxx

# Canva API for template generation  
# CANVA_API_KEY=xxx

# ============================================
# OPTIONAL: AI Generation (Required for logo generation)
# ============================================
# Google AI API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# You can use any of these variable names:
GENKIT_API_KEY=AIzaSy...
# TEST_GOOGLE_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...

# Test database (isolated from production)
# TEST_DATABASE_URL=mysql://root:password@localhost:3306/logogenius_test

# ============================================
# OPTIONAL: Monitoring & Analytics
# ============================================
# Sentry for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# OPTIONAL: File Storage
# ============================================
# AWS S3 for file storage (default: local filesystem)
# AWS_S3_BUCKET=logogenius-assets
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Enable detailed logging
# DEBUG=true

# Skip auth checks (NOT for production)
# SKIP_AUTH=true
