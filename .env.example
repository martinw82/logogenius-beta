# ==========================================
# LogoGenius - Environment Configuration
# ==========================================

# ==========================================
# REQUIRED: Core Application
# ==========================================

# Database - MySQL connection string
# Format: mysql://username:password@host:port/database?sslmode=require
# Get from: Railway, PlanetScale, AWS RDS, or your VPS
DATABASE_URL=mysql://username:password@host:port/database?sslmode=require

# Admin Authentication
# Set a strong password for admin panel access
ADMIN_PASSWORD=your-secure-admin-password-here

# JWT Secret - for signing authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here

# ==========================================
# REQUIRED: AI Services (Pick at least one)
# ==========================================

# Google API Key - REQUIRED for form auto-fill (FREE tier available)
# Get from: https://ai.google.dev
# Used for: Form auto-fill, brand guide text generation
GOOGLE_API_KEY=your_google_ai_key_here

# --- Provider 1: Together AI (Default for testing) ---
# Cost: ~$0.001/image | Free $5 credit on signup
# Signup: https://api.together.xyz
# Used for: Logo generation
TOGETHER_API_KEY=your_together_api_key_here

# --- Provider 2: Replicate (Recommended for production) ---
# Cost: ~$0.05/image | Free $5 credit on signup
# Signup: https://replicate.com
# Used for: Logo generation (Google Imagen 3)
REPLICATE_API_KEY=your_replicate_api_key_here

# --- Provider 3: Fal.ai ---
# Cost: ~$0.15/image
# Signup: https://fal.ai
# Used for: Logo generation
FAL_API_KEY=your_fal_api_key_here

# --- Provider 4: Laozhang.ai ---
# Cost: ~$0.05/image
# Signup: https://laozhang.ai
# Used for: Logo generation
LAOZHANG_API_KEY=your_laozhang_api_key_here

# --- Provider 5: Recraft AI (RECOMMENDED for logos - SVG output!) ---
# Cost: $0.044/vector (V2) | $0.04/raster (V3) | $0.08/vector (V3)
# Signup: https://www.recraft.ai
# Features: Native SVG output, built for brand assets, professional quality
# Why: Only provider that outputs editable vector logos!
RECRAFT_API_KEY=your_recraft_api_key_here

# Recraft Configuration
# VECTOR_MODE: true = SVG (scalable, editable), false = PNG (raster)
# Recommended: true (get actual vector logos!)
RECRAFT_VECTOR_MODE=true

# STYLE: Controls the generation style
# Options: vector_illustration | logo | icon | line_art | photorealistic
# For logos: "vector_illustration" or "logo"
RECRAFT_STYLE=vector_illustration

# ==========================================
# OPTIONAL: Image Generation Provider Selection
# ==========================================

# Set this to switch between providers
# Options: together | replicate | fal | google | laozhang | recraft
# Default: together
# RECOMMENDED FOR PRODUCTION: recraft (for SVG logos)
IMAGE_GEN_PROVIDER=together

# ==========================================
# OPTIONAL: Prompt Style Configuration
# ==========================================

# Override prompt formatting style (auto-detected from provider by default)
# Use this if you want different prompt formatting than the provider default
# Options: sd-flux | imagen3 | recraft
# sd-flux: Anti-pattern, comma-separated (for Stable Diffusion)
# imagen3: Natural language (for Google Imagen 3)
# recraft: Design brief style (for Recraft AI)
# PROMPT_STYLE=recraft

# ==========================================
# OPTIONAL: Application URLs
# ==========================================

# Base URL of your application
# Used for: Email links, metadata, redirects
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Site URL for email templates
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ==========================================
# OPTIONAL: Mockup Generation Provider Selection
# ==========================================

# Set this to switch between mockup providers
# Options: dynamicmockups | mockupsjar | mockcity
# Default: dynamicmockups
MOCKUP_PROVIDER=dynamicmockups

# --- Provider 1: Dynamic Mockups (Default - best free tier) ---
# Free: 1,000 renders forever (with watermark) | Paid: $19/mo Pro, $49/mo API
# Speed: 0.6-2.8s per render | Rate limit: 300/min
# Signup: https://dynamicmockups.com
# Docs: https://docs.dynamicmockups.com
DYNAMIC_MOCKUPS_API_KEY=your_dynamic_mockups_api_key_here

# --- Provider 2: MockupsJar (Simple REST API) ---
# Free: 100 renders/month | Paid: €45/mo for 1,000 renders
# Templates: 700+ device/product mockups
# Signup: https://mockupsjar.com/api
# Docs: https://mockupsjar.com/apidoc
MOCKUPSJAR_API_KEY=your_mockupsjar_api_key_here

# --- Provider 3: MockCity (Any PSD template) ---
# Credit-based (pay as you go) | Works with any CreativeMarket PSD
# Speed: 15-20s worker spawn, then 5-10s per render
# Signup: https://mockcity.com
# Docs: https://mockcity.com/api/docs
MOCKCITY_API_KEY=your_mockcity_api_key_here

# ==========================================
# OPTIONAL: Image Hosting (for mockup APIs)
# ==========================================

# imgbb - Free image hosting for passing logos to mockup APIs
# Required only if using MockupsJar or MockCity (URL-based providers)
# NOT needed for Dynamic Mockups (supports binary file upload)
# Free: unlimited uploads | Get key at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# ==========================================
# OPTIONAL: Third-Party Integrations
# ==========================================

# Figma API - for generating Figma templates (Tier 3)
# Get from: https://www.figma.com/developers/api
FIGMA_API_TOKEN=your_figma_token_here

# Canva API - for generating Canva templates (Tier 3)
# Get from: https://www.canva.com/developers/
CANVA_API_KEY=your_canva_key_here
CANVA_TEAM_ID=your_canva_team_id_here

# ==========================================
# OPTIONAL: PDF Generation (New Puppeteer-based)
# ==========================================

# Enable Puppeteer-based PDF generation (agency-quality brand guides)
# When true: Uses Puppeteer + Handlebars for HTML-to-PDF (better quality)
# When false: Uses jsPDF (basic quality, faster)
# Default: false
USE_PUPPETEER_PDF=false

# Chromium path for Puppeteer (optional)
# If not set, will try to auto-detect Chrome/Chromium
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/chromium-browser
# CHROMIUM_PATH=

# Puppeteer cache directory (required for Vercel/serverless)
# PUPPETEER_CACHE_DIR=/tmp/.cache

# Base path to archetype assets (optional)
# Default: ./assets
# ASSETS_BASE_PATH=./assets

# ==========================================
# REQUIRED: Stripe Payments
# ==========================================

# Stripe Secret Key - from Stripe Dashboard → Developers → API Keys
# Use sk_test_... for testing, sk_live_... for production
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret - from Stripe Dashboard → Developers → Webhooks
# Created after setting up webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs - from Stripe Dashboard → Products
# Create 3 products (Starter $29, Professional $49, Enterprise $99) and copy Price IDs
STRIPE_PRICE_STARTER=price_starter_price_id_here
STRIPE_PRICE_PRO=price_pro_price_id_here
STRIPE_PRICE_ENTERPRISE=price_enterprise_price_id_here

# Base URL for Stripe redirects (must match your deployed URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ==========================================
# OPTIONAL: Testing & Development
# ==========================================

# Test mode - uses cheaper/faster options
# Options: testing | production
# Default: testing
MODE=testing

# Track AI generation costs
# Default: false
TRACK_GENERATION_COSTS=false

# ==========================================
# DEPRECATED: Old Variable Names (don't use)
# ==========================================
# ADMIN_KEY (use ADMIN_PASSWORD instead)
# GENKIT_API_KEY (use GOOGLE_API_KEY instead)
# TEST_GOOGLE_API_KEY (use GOOGLE_API_KEY instead)
