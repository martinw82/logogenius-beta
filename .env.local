# LogoGenius Environment Configuration
# Generated for testing - CHANGE THESE VALUES FOR PRODUCTION!

# ============================================
# REQUIRED: Database
# ============================================
# MySQL connection string
# Update with your actual MySQL credentials
DATABASE_URL="mysql://jJWxcidyvDXaFke.root:5PftRNlOQ693Y7nN@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/test?sslmode=required"

# ============================================
# REQUIRED: Admin Authentication
# ============================================
# Default admin password - CHANGE THIS!
ADMIN_PASSWORD="admin123"

# JWT secret for session tokens - CHANGE THIS to a random string!
JWT_SECRET="logogenius-secret-key-for-jwt-tokens-min-32-chars"

# ============================================
# REQUIRED: Application
# ============================================
# Base URL for the application
NEXT_PUBLIC_BASE_URL="http://localhost:9002"

# ============================================
# OPTIONAL: Mockup Generation
# ============================================
# Options: dynamicmockups | mockupsjar | mockcity
MOCKUP_PROVIDER=dynamicmockups
# DYNAMIC_MOCKUPS_API_KEY=""
# MOCKUPSJAR_API_KEY=""
# MOCKCITY_API_KEY=""
# IMGBB_API_KEY=""  # Needed for MockupsJar/MockCity (not needed for Dynamic Mockups)

# ============================================
# OPTIONAL: Testing
# ============================================
# Google AI API key for logo generation (optional for testing)
# TEST_GOOGLE_API_KEY=""

# ============================================
# OPTIONAL: PDF Generation (Puppeteer)
# ============================================
# Path to Chromium/Chrome binary for Puppeteer PDF generation (local dev only).
# On Vercel/serverless, leave unset — @sparticuz/chromium handles it automatically.
CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Enable Puppeteer-based PDF generation (agency-quality brand guides)
# When true: Uses Puppeteer + Handlebars for HTML-to-PDF (better quality)
# When false: Uses jsPDF (basic quality, faster)
USE_PUPPETEER_PDF=true
