# LogoGenius Environment Configuration
# Generated for testing - CHANGE THESE VALUES FOR PRODUCTION!

# ============================================
# REQUIRED: Database
# ============================================
# MySQL connection string
# Update with your actual MySQL credentials
DATABASE_URL="mysql://root:password@localhost:3306/logogenius"

# ============================================
# REQUIRED: Admin Authentication
# ============================================
# Default admin password - CHANGE THIS!
ADMIN_PASSWORD="admin123"

# JWT secret for session tokens - CHANGE THIS to a random string!
JWT_SECRET="change-this-to-a-random-secret-key-min-32-chars"

# ============================================
# REQUIRED: Application
# ============================================
# Base URL for the application
NEXT_PUBLIC_BASE_URL="http://localhost:9002"

# ============================================
# OPTIONAL: Testing
# ============================================
# Google AI API key for logo generation (optional for testing)
# TEST_GOOGLE_API_KEY=""
