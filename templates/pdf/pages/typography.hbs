<!-- Typography Page -->
<div class="page">
  <!-- Page Header -->
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Typography</span>
  </div>
  
  <div class="content">
    <!-- Section Heading -->
    <div class="section-heading">
      <div>
        <h1>Typography Guide</h1>
        <p class="subtitle">Font families, hierarchy, and usage guidelines</p>
      </div>
    </div>
    
    <!-- Typography Description -->
    {{#if typographyText}}
    <p>{{typographyText}}</p>
    {{/if}}
    
    <!-- Heading Font Showcase -->
    {{#if fontHeadings}}
    <h2>Primary Typeface: {{fontHeadings}}</h2>
    
    <div class="alphabet-specimen" style="font-family: '{{fontHeadings}}', sans-serif; font-weight: 600;">
      Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz
    </div>
    <div class="alphabet-specimen" style="font-family: '{{fontHeadings}}', sans-serif; font-weight: 600;">
      1234567890 !@#$%&*()
    </div>
    
    <div class="type-hierarchy">
      <div class="type-sample">
        <div class="sample-text" style="font-family: '{{fontHeadings}}', sans-serif; font-size: 48px; font-weight: 700; letter-spacing: -0.02em;">
          Display Heading
        </div>
        <div class="sample-label">Display — 48pt / Bold / {{fontHeadings}}</div>
      </div>
      
      <div class="type-sample">
        <div class="sample-text" style="font-family: '{{fontHeadings}}', sans-serif; font-size: 32px; font-weight: 600; letter-spacing: -0.01em;">
          Section Title
        </div>
        <div class="sample-label">H1 — 32pt / Semi-bold / {{fontHeadings}}</div>
      </div>
      
      <div class="type-sample">
        <div class="sample-text" style="font-family: '{{fontHeadings}}', sans-serif; font-size: 24px; font-weight: 600;">
          Subsection Heading
        </div>
        <div class="sample-label">H2 — 24pt / Semi-bold / {{fontHeadings}}</div>
      </div>
      
      <div class="type-sample">
        <div class="sample-text" style="font-family: '{{fontHeadings}}', sans-serif; font-size: 18px; font-weight: 600;">
          Subheading
        </div>
        <div class="sample-label">H3 — 18pt / Semi-bold / {{fontHeadings}}</div>
      </div>
    </div>
    {{/if}}
    
    <!-- Body Font Showcase -->
    {{#if fontBody}}
    <h2 style="margin-top: 48px;">Body Typeface: {{fontBody}}</h2>
    
    <div class="alphabet-specimen" style="font-family: '{{fontBody}}', sans-serif;">
      Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz
    </div>
    
    <div class="type-hierarchy">
      <div class="type-sample">
        <div class="sample-text" style="font-family: '{{fontBody}}', sans-serif; font-size: 16px; line-height: 1.6;">
          Body text for paragraphs and general content. This is how the body text appears when used in longer passages of content across brand materials.
        </div>
        <div class="sample-label">Body — 16pt / Regular / {{fontBody}}</div>
      </div>
      
      <div class="type-sample">
        <div class="sample-text" style="font-family: '{{fontBody}}', sans-serif; font-size: 12px; color: #666;">
          Small text for captions, footnotes, and metadata.
        </div>
        <div class="sample-label">Caption — 12pt / Regular / {{fontBody}}</div>
      </div>
    </div>
    {{/if}}
    
    <!-- Font Pairing Rationale -->
    <div class="callout" style="margin-top: 32px;">
      <p><strong>Font Pairing:</strong> {{fontHeadings}} provides strong visual hierarchy for headlines, while {{fontBody}} ensures excellent readability for body content. This combination creates a balanced typographic system that feels both authoritative and approachable.</p>
    </div>
  </div>
  
  <!-- Page Footer -->
  <div class="page-footer">
    <span>{{businessName}} Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>
