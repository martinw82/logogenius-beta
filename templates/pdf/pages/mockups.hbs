<!-- Mockup Gallery Page (GL-08/09) -->
<div class="page">
  <!-- Section number overlay -->
  {{#if sectionNumber}}
  <div class="section-number-overlay">{{padZero sectionNumber}}</div>
  {{/if}}

  <!-- Page header chrome -->
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Applications</span>
  </div>

  <div class="content">
    <!-- Section heading -->
    <div class="section-heading">
      <div class="section-heading-text">
        <h1>Applications</h1>
        <p class="subtitle">Real-world brand applications and mockups</p>
      </div>
    </div>

    <p>Your brand identity applied across key touchpoints, demonstrating consistency and professionalism in every context.</p>

    <!-- Dark background mockup gallery -->
    <div class="mockup-gallery">
      <div class="mockup-gallery-grid">
        {{#if mockups.businesscard}}
        <div class="mockup-gallery-item full-width">
          <img src="{{mockups.businesscard}}" alt="Business Card">
          <div class="mockup-caption">Business Card</div>
        </div>
        {{/if}}

        {{#if mockups.letterhead}}
        <div class="mockup-gallery-item">
          <img src="{{mockups.letterhead}}" alt="Letterhead">
          <div class="mockup-caption">Letterhead</div>
        </div>
        {{/if}}

        {{#if mockups.tshirt}}
        <div class="mockup-gallery-item">
          <img src="{{mockups.tshirt}}" alt="Apparel">
          <div class="mockup-caption">Apparel</div>
        </div>
        {{/if}}

        {{#if mockups.coffeeMug}}
        <div class="mockup-gallery-item">
          <img src="{{mockups.coffeeMug}}" alt="Coffee Mug">
          <div class="mockup-caption">Coffee Mug</div>
        </div>
        {{/if}}

        {{#if mockups.toteBag}}
        <div class="mockup-gallery-item">
          <img src="{{mockups.toteBag}}" alt="Tote Bag">
          <div class="mockup-caption">Tote Bag</div>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- Page footer -->
  <div class="page-footer">
    <span>Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>
