<!-- Mockup Gallery Page -->
<div class="page">
  <!-- Page Header -->
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Applications</span>
  </div>
  
  <div class="content">
    <!-- Section Heading -->
    <div class="section-heading">
      <div>
        <h1>Applications</h1>
        <p class="subtitle">Real-world brand applications and mockups</p>
      </div>
    </div>
    
    <!-- Mockup Gallery -->
    <div class="mockup-gallery">
      {{#if mockups.businesscard}}
      <div class="mockup-item">
        <img src="{{mockups.businesscard}}" alt="Business Card Mockup" class="mockup-image" />
        <div class="mockup-caption">Business Card — Professional Networking</div>
      </div>
      {{/if}}
      
      {{#if mockups.letterhead}}
      <div class="mockup-item">
        <img src="{{mockups.letterhead}}" alt="Letterhead Mockup" class="mockup-image" />
        <div class="mockup-caption">Letterhead — Official Correspondence</div>
      </div>
      {{/if}}
      
      {{#if mockups.tshirt}}
      <div class="mockup-item">
        <img src="{{mockups.tshirt}}" alt="T-Shirt Mockup" class="mockup-image" />
        <div class="mockup-caption">Apparel — Branded Merchandise</div>
      </div>
      {{/if}}
      
      {{#if mockups.coffeeMug}}
      <div class="mockup-item">
        <img src="{{mockups.coffeeMug}}" alt="Coffee Mug Mockup" class="mockup-image" />
        <div class="mockup-caption">Coffee Mug — Promotional Items</div>
      </div>
      {{/if}}
      
      {{#if mockups.toteBag}}
      <div class="mockup-item">
        <img src="{{mockups.toteBag}}" alt="Tote Bag Mockup" class="mockup-image" />
        <div class="mockup-caption">Tote Bag — Event & Conference Materials</div>
      </div>
      {{/if}}
    </div>
    
    {{#unless mockups.businesscard}}
    {{#unless mockups.letterhead}}
    {{#unless mockups.tshirt}}
    {{#unless mockups.coffeeMug}}
    {{#unless mockups.toteBag}}
    <div style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
      <p>Mockup images will be generated and displayed here.</p>
      <p class="micro-label" style="margin-top: 16px;">Applications showcase</p>
    </div>
    {{/unless}}
    {{/unless}}
    {{/unless}}
    {{/unless}}
    {{/unless}}
  </div>
  
  <!-- Page Footer -->
  <div class="page-footer">
    <span>{{businessName}} Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>
