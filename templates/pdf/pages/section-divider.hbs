<!-- Section Divider Page -->
<div class="page page-divider">
  <!-- Layer 3: Pattern Overlay -->
  {{#if brandAssets.selectedPattern}}
  <div class="layer-pattern" style="background-image: url('{{assetsBaseUrl}}/{{brandAssets.packName}}/{{brandAssets.selectedPattern}}');"></div>
  {{/if}}
  
  <!-- Large Section Number -->
  <div class="divider-number">{{sectionNumber}}</div>
  
  <!-- Section Title -->
  <div class="divider-title">{{sectionTitle}}</div>
  
  <!-- Optional Subtitle -->
  {{#if sectionSubtitle}}
  <div class="divider-subtitle">{{sectionSubtitle}}</div>
  {{/if}}
</div>
