<!-- Color Palette Page (GL-04) -->
<div class="page">
  <!-- Layer 1: Subtle texture -->
  {{#if brandAssets.selectedTexture}}
  <div class="layer-texture" style="background-image: url('{{assetsBaseUrl}}/{{brandAssets.packName}}/{{brandAssets.selectedTexture}}'); opacity: 0.04;"></div>
  {{/if}}

  <!-- Section number overlay -->
  <div class="section-number-overlay">{{padZero sectionNumber}}</div>

  <!-- Page header chrome -->
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Color Palette</span>
  </div>

  <div class="content">
    <!-- Section heading with chrome accent bar -->
    <div class="section-heading">
      <div class="section-heading-text">
        <h1>Color Palette</h1>
        <p class="subtitle">Brand colors with full specifications</p>
      </div>
    </div>

    {{#if colorPaletteText}}
    <p>{{colorPaletteText}}</p>
    {{/if}}

    <!-- Primary Colors -->
    {{#if (hasItems primaryColors)}}
    <h3>Primary Colors</h3>
    <div class="swatch-row">
      {{#each primaryColors}}
      <div class="swatch-card">
        <div class="swatch-block swatch-block--large" style="background: {{this}};">
          <span style="color: {{contrastColor this}}; font-family: var(--chrome-font); font-size: 12px; font-weight: 500;">{{this}}</span>
        </div>
        <div class="swatch-info">
          <div class="swatch-hex">{{this}}</div>
          <div class="swatch-values">RGB: {{hexToRgb this}}</div>
          <div class="swatch-values">CMYK: {{hexToCmyk this}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Secondary Colors -->
    {{#if (hasItems secondaryColors)}}
    <h3>Secondary Colors</h3>
    <div class="swatch-row">
      {{#each secondaryColors}}
      <div class="swatch-card">
        <div class="swatch-block swatch-block--small" style="background: {{this}};">
          <span style="color: {{contrastColor this}}; font-family: var(--chrome-font); font-size: 11px;">{{this}}</span>
        </div>
        <div class="swatch-info">
          <div class="swatch-hex">{{this}}</div>
          <div class="swatch-values">RGB: {{hexToRgb this}} · CMYK: {{hexToCmyk this}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Accent Colors -->
    {{#if (hasItems accentColors)}}
    <h3>Accent Colors</h3>
    <div class="swatch-row">
      {{#each accentColors}}
      <div class="swatch-card">
        <div class="swatch-block swatch-block--small" style="background: {{this}};">
          <span style="color: {{contrastColor this}}; font-family: var(--chrome-font); font-size: 11px;">{{this}}</span>
        </div>
        <div class="swatch-info">
          <div class="swatch-hex">{{this}}</div>
          <div class="swatch-values">RGB: {{hexToRgb this}} · CMYK: {{hexToCmyk this}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- 60/30/10 Usage Bar -->
    <h3>Color Usage Proportions</h3>
    <div class="usage-bar">
      <div class="usage-bar-segment" style="background: {{primaryColor}}; flex: 6; border-radius: 4px 0 0 4px;"></div>
      <div class="usage-bar-segment" style="background: {{secondaryColor}}; flex: 3;"></div>
      <div class="usage-bar-segment" style="background: {{accentColor}}; flex: 1; border-radius: 0 4px 4px 0;"></div>
    </div>
    <div class="usage-labels">
      <div class="usage-label-item">
        <div class="usage-dot" style="background: {{primaryColor}};"></div>
        60% Primary
      </div>
      <div class="usage-label-item">
        <div class="usage-dot" style="background: {{secondaryColor}};"></div>
        30% Secondary
      </div>
      <div class="usage-label-item">
        <div class="usage-dot" style="background: {{accentColor}};"></div>
        10% Accent
      </div>
    </div>
  </div>

  <!-- Page footer -->
  <div class="page-footer">
    <span>Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>
