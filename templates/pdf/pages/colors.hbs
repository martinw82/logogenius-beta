<!-- Color Palette Page -->
<div class="page">
  <!-- Page Header -->
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Color Palette</span>
  </div>

  <div class="content">
    <!-- Section Heading -->
    <div class="section-heading">
      <div>
        <h1>Color Palette</h1>
        <p class="subtitle">Brand colors with specifications and usage guidelines</p>
      </div>
    </div>

    <!-- Color Palette Description -->
    {{#if colorPaletteText}}
    <p>{{colorPaletteText}}</p>
    {{/if}}

    <!-- Primary Colors — Large Hero Swatches -->
    {{#if primaryColors.length}}
    <h2>Primary Colors</h2>
    <p>Core brand colors that define your visual identity. Use for dominant elements and key brand touchpoints.</p>
    <div class="swatch-row swatch-row-primary">
      {{#each primaryColors}}
      <div class="swatch-hero" style="background: {{this}}; color: {{contrastColor this}};">
        <div class="swatch-hex">{{this}}</div>
        <div class="swatch-values">
          <span class="swatch-val-label">RGB</span> {{hexToRgb this}}<br>
          <span class="swatch-val-label">CMYK</span> {{hexToCmyk this}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Secondary Colors — Medium Swatches -->
    {{#if secondaryColors.length}}
    <h2>Secondary Colors</h2>
    <p>Supporting colors that complement your primary palette.</p>
    <div class="swatch-row">
      {{#each secondaryColors}}
      <div class="swatch-primary" style="background: {{this}}; color: {{contrastColor this}};">
        <div class="swatch-hex">{{this}}</div>
        <div class="swatch-values">
          <span class="swatch-val-label">RGB</span> {{hexToRgb this}}<br>
          <span class="swatch-val-label">CMYK</span> {{hexToCmyk this}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Accent Colors — Small Swatches -->
    {{#if accentColors.length}}
    <h2>Accent Colors</h2>
    <p>Use sparingly for highlights, calls-to-action, and emphasis.</p>
    <div class="swatch-row">
      {{#each accentColors}}
      <div class="swatch-secondary" style="background: {{this}}; color: {{contrastColor this}};">
        <div class="swatch-hex">{{this}}</div>
        <div class="swatch-values">
          <span class="swatch-val-label">RGB</span> {{hexToRgb this}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Color Usage Proportions (60/30/10 Rule) -->
    <h2>Color Usage Proportions</h2>
    <p>Follow the 60-30-10 rule for balanced color application across all brand touchpoints:</p>

    <div class="usage-bar">
      <div class="usage-bar-segment" style="width: 60%; background: {{primaryColor}}; border-radius: var(--radius) 0 0 var(--radius);"></div>
      <div class="usage-bar-segment" style="width: 30%; background: {{secondaryColor}};"></div>
      <div class="usage-bar-segment" style="width: 10%; background: {{accentColor}}; border-radius: 0 var(--radius) var(--radius) 0;"></div>
    </div>

    <div class="usage-labels">
      <span><strong>60%</strong> Primary</span>
      <span><strong>30%</strong> Secondary</span>
      <span><strong>10%</strong> Accent</span>
    </div>

    <!-- Color Combinations -->
    <h2 style="margin-top: 48px;">Color Combinations</h2>
    <p>Approved pairings for backgrounds, text, and interactive elements.</p>

    <div class="color-combos">
      {{#if primaryColors.length}}
      <div class="combo-card">
        <div class="combo-swatch" style="background: {{primaryColor}};">
          <span style="color: {{contrastColor primaryColor}}; font-family: var(--font-heading); font-weight: 700;">Aa</span>
        </div>
        <div class="combo-label">
          <span class="combo-name">Primary on White</span>
          <span class="combo-use">Headlines, buttons, links</span>
        </div>
      </div>
      {{/if}}
      {{#if secondaryColors.length}}
      <div class="combo-card">
        <div class="combo-swatch" style="background: {{secondaryColor}};">
          <span style="color: {{contrastColor secondaryColor}}; font-family: var(--font-heading); font-weight: 700;">Aa</span>
        </div>
        <div class="combo-label">
          <span class="combo-name">Secondary on White</span>
          <span class="combo-use">Subheadings, borders, accents</span>
        </div>
      </div>
      {{/if}}
      {{#if primaryColors.length}}
      <div class="combo-card">
        <div class="combo-swatch combo-swatch-dark" style="background: #1a1a1a;">
          <span style="color: {{primaryColor}}; font-family: var(--font-heading); font-weight: 700;">Aa</span>
        </div>
        <div class="combo-label">
          <span class="combo-name">Primary on Dark</span>
          <span class="combo-use">Dark backgrounds, overlays</span>
        </div>
      </div>
      {{/if}}
      {{#if accentColors.length}}
      <div class="combo-card">
        <div class="combo-swatch" style="background: {{accentColor}};">
          <span style="color: {{contrastColor accentColor}}; font-family: var(--font-heading); font-weight: 700;">Aa</span>
        </div>
        <div class="combo-label">
          <span class="combo-name">Accent Highlight</span>
          <span class="combo-use">CTAs, notifications, badges</span>
        </div>
      </div>
      {{/if}}
    </div>

    <!-- Accessibility Note -->
    <div class="callout" style="margin-top: 40px;">
      <p><strong>Accessibility:</strong> Ensure a minimum contrast ratio of 4.5:1 for body text and 3:1 for large text against backgrounds. Use the contrast color helpers to select appropriate text colors on brand swatches. Test color combinations with accessibility tools before production use.</p>
    </div>
  </div>

  <!-- Page Footer -->
  <div class="page-footer">
    <span>{{businessName}} Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>
