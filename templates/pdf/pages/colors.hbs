<!-- Color Palette Page -->
<div class="page page-content">
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Color Palette</span>
  </div>
  
  <div class="section-body">
    <div class="section-heading">
      <h1>Color Palette</h1>
    </div>
    
    <p>{{colorPaletteText}}</p>
    
    {{#if primaryColors.length}}
    <h2>Primary Colors</h2>
    <p>Core brand colors that define your visual identity. Use for dominant elements and key brand touchpoints.</p>
    <div class="color-grid">
      {{#each primaryColors}}
      <div class="color-swatch">
        <div class="color-block" style="background: {{this}};">
          <span style="color: {{contrastColor this}}; font-size: 8pt;">{{this}}</span>
        </div>
        <div class="color-info">
          <div class="color-hex">{{this}}</div>
          <div class="color-values">RGB: {{hexToRgb this}}</div>
          <div class="color-values">CMYK: {{hexToCmyk this}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
    
    {{#if secondaryColors.length}}
    <h2>Secondary Colors</h2>
    <p>Supporting colors that complement your primary palette.</p>
    <div class="color-grid">
      {{#each secondaryColors}}
      <div class="color-swatch">
        <div class="color-block" style="background: {{this}};">
          <span style="color: {{contrastColor this}}; font-size: 8pt;">{{this}}</span>
        </div>
        <div class="color-info">
          <div class="color-hex">{{this}}</div>
          <div class="color-values">RGB: {{hexToRgb this}}</div>
          <div class="color-values">CMYK: {{hexToCmyk this}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
    
    {{#if accentColors.length}}
    <h2>Accent Colors</h2>
    <p>Use sparingly for highlights, calls-to-action, and emphasis.</p>
    <div class="color-grid">
      {{#each accentColors}}
      <div class="color-swatch">
        <div class="color-block" style="background: {{this}};">
          <span style="color: {{contrastColor this}}; font-size: 8pt;">{{this}}</span>
        </div>
        <div class="color-info">
          <div class="color-hex">{{this}}</div>
          <div class="color-values">RGB: {{hexToRgb this}}</div>
          <div class="color-values">CMYK: {{hexToCmyk this}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
    
    <h2>Color Usage Proportions</h2>
    <p>Follow the 60-30-10 rule for balanced color application:</p>
    
    <div class="usage-bar">
      <div class="usage-bar-segment" style="flex: 6; background: var(--primary);"></div>
      <div class="usage-bar-segment" style="flex: 3; background: var(--secondary);"></div>
      <div class="usage-bar-segment" style="flex: 1; background: var(--accent);"></div>
    </div>
    <div style="display: flex; justify-content: space-between; font-family: var(--chrome-font); font-size: 10px; opacity: 0.7; margin-top: 4px;">
      <span>60% Primary</span>
      <span>30% Secondary</span>
      <span>10% Accent</span>
    </div>
  </div>
  
  <div class="page-footer">
    <span>{{businessName}} Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>