<!-- Do's and Don'ts Page -->
<div class="page">
  <!-- Page Header -->
  <div class="page-header">
    <span class="brand-name">{{businessName}}</span>
    <span class="section-name">Usage Rules</span>
  </div>
  
  <div class="content">
    <!-- Section Heading -->
    <div class="section-heading">
      <div>
        <h1>Logo Usage</h1>
        <p class="subtitle">Guidelines for correct and incorrect logo usage</p>
      </div>
    </div>
    
    <!-- Usage Rules Description -->
    {{#if usageRulesText}}
    <p>{{usageRulesText}}</p>
    {{/if}}
    
    <!-- Do / Don't Grid -->
    <div class="do-dont-grid">
      <!-- DO Column -->
      <div class="do-box">
        <div class="do-label">✓ Do</div>
        <ul style="list-style: none; padding: 0;">
          <li style="margin-bottom: 8px;">✓ Use on approved backgrounds only</li>
          <li style="margin-bottom: 8px;">✓ Maintain clear space around the logo</li>
          <li style="margin-bottom: 8px;">✓ Use approved color variations</li>
          <li style="margin-bottom: 8px;">✓ Scale proportionally</li>
          <li>✓ Use provided logo files</li>
        </ul>
      </div>
      
      <!-- DON'T Column -->
      <div class="dont-box">
        <div class="dont-label">✗ Don't</div>
        <ul style="list-style: none; padding: 0;">
          <li style="margin-bottom: 8px;">✗ Stretch or distort the logo</li>
          <li style="margin-bottom: 8px;">✗ Rotate or tilt the logo</li>
          <li style="margin-bottom: 8px;">✗ Change the logo colors</li>
          <li style="margin-bottom: 8px;">✗ Add effects (shadows, glows)</li>
          <li>✗ Place on busy backgrounds</li>
        </ul>
      </div>
    </div>
    
    <!-- Visual Misuse Examples -->
    <h3>Common Misuse Examples</h3>
    
    <div class="do-dont-grid" style="margin-top: 24px;">
      <div>
        <div class="misuse-example">
          <div style="font-style: normal; color: var(--text-dark);">Logo stretched horizontally</div>
          <div style="transform: scaleX(1.3); display: inline-block; margin-top: 8px; font-weight: bold; color: var(--dont-red);">{{businessName}}</div>
        </div>
        <p class="micro-label" style="text-align: center;">Never stretch or distort</p>
      </div>
      
      <div>
        <div class="misuse-example">
          <div style="font-style: normal; color: var(--text-dark);">Logo rotated</div>
          <div style="transform: rotate(-15deg); display: inline-block; margin-top: 8px; font-weight: bold; color: var(--dont-red);">{{businessName}}</div>
        </div>
        <p class="micro-label" style="text-align: center;">Never rotate or tilt</p>
      </div>
    </div>
    
    <div class="do-dont-grid">
      <div>
        <div class="misuse-example">
          <div style="font-style: normal; color: var(--text-dark);">Wrong colors applied</div>
          <div style="display: inline-block; margin-top: 8px; font-weight: bold; color: #ff00ff;">{{businessName}}</div>
        </div>
        <p class="micro-label" style="text-align: center;">Never change colors</p>
      </div>
      
      <div>
        <div class="misuse-example">
          <div style="font-style: normal; color: var(--text-dark);">Effects added</div>
          <div style="display: inline-block; margin-top: 8px; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">{{businessName}}</div>
        </div>
        <p class="micro-label" style="text-align: center;">Never add effects</p>
      </div>
    </div>
    
    <!-- Callout with guidance -->
    <div class="callout" style="margin-top: 32px;">
      <p>When in doubt, always refer to the provided logo files and contact the brand team for approval. Maintaining consistent logo usage ensures strong brand recognition and protects brand equity.</p>
    </div>
  </div>
  
  <!-- Page Footer -->
  <div class="page-footer">
    <span>{{businessName}} Brand Guidelines</span>
    <span>{{pageNumber}}</span>
  </div>
</div>
