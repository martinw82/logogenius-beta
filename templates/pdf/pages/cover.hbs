<!-- Cover Page -->
<div class="page page-cover">
  {{#if brandAssets.selectedTexture}}
  <div class="layer-texture"></div>
  {{/if}}
  
  {{#if brandAssets.selectedAccent}}
  <div class="layer-accent"></div>
  {{/if}}
  
  <div class="guidelines-label">Brand Guidelines</div>
  
  <div class="logo-container">
    {{#if logoSvg}}
      {{{logoSvg}}}
    {{else}}
      <div style="font-family: var(--heading-font); font-size: 36pt; font-weight: 700;">{{businessName}}</div>
    {{/if}}
  </div>
  
  <div class="business-name">{{businessName}}</div>
  
  {{#if tagline}}
  <div class="tagline">{{tagline}}</div>
  {{/if}}
  
  <div class="date-footer">{{formatDate createdAt}}</div>
</div>