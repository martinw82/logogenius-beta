<!-- Cover Page -->
<div class="page page-cover">
  <!-- Layer 1: Background Texture -->
  {{#if brandAssets.selectedTexture}}
  <div class="layer-texture" style="background-image: url('{{assetsBaseUrl}}/{{brandAssets.packName}}/{{brandAssets.selectedTexture}}');"></div>
  {{/if}}
  
  <!-- Layer 2: Geometric Accent -->
  {{#if brandAssets.selectedAccent}}
  <div class="layer-accent" style="background-image: url('{{assetsBaseUrl}}/{{brandAssets.packName}}/{{brandAssets.selectedAccent}}'); {{brandAssets.accentSide}}: 0;"></div>
  {{/if}}
  
  <!-- Guidelines Label -->
  <div class="guidelines-label">Brand Guidelines</div>
  
  <!-- Logo Container (Center) -->
  <div class="logo-container">
    {{#if logoSvg}}
      {{{logoSvg}}}
    {{else}}
      <div style="font-family: var(--font-heading); font-size: 36pt; font-weight: 700;">{{businessName}}</div>
    {{/if}}
  </div>
  
  <!-- Business Name (Bottom Left) -->
  <div class="business-name">{{businessName}}</div>
  
  <!-- Tagline -->
  {{#if tagline}}
  <div class="tagline">{{tagline}}</div>
  {{/if}}
  
  <!-- Date Footer -->
  <div class="date-footer">{{formatDate createdAt}} | {{businessName}}</div>
</div>
