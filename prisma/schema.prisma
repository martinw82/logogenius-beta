// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BrandArchetype {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @db.Text
  traits      String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Order {
  id              Int      @id @default(autoincrement())
  tier            String
  status          String   @default("pending")
  customerEmail   String?
  selectedLogoId  Int?
  stripeSessionId String?  @unique
  paymentStatus   String   @default("unpaid")
  amount          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  details      OrderDetail[]
  logoVariants LogoVariant[]

  @@index([status])
  @@index([tier])
  @@index([customerEmail])
  @@index([stripeSessionId])
}

model OrderDetail {
  id         Int      @id @default(autoincrement())
  orderId    Int
  fieldName  String
  fieldValue String   @db.LongText
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([fieldName])
  @@unique([orderId, fieldName])
}

model AdminSession {
  id        Int      @id @default(autoincrement())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([token])
}

model LogoVariant {
  id          Int      @id @default(autoincrement())
  orderId     Int
  variantNum  Int
  svgData     String   @db.LongText
  svgPath     String?
  selected    Boolean  @default(false)
  mockupPaths String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantNum])
  @@unique([orderId, variantNum])
}
